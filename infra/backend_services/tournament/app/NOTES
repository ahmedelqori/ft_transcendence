pool: {
    afterCreate: (conn, cb) => {
    conn.run('PRAGMA foreign_keys = ON', cb); // Enable foreign keys
    }
}








create tournament
POST /api/tournament/

{
    "tournament_name": "t1212",
    "nickname": "7h323",
    "players_number": 12
}

response:

201
{
    "owner_id": 22,
    "tournament_name": "t1212",
    "players_number": 16,
    "id": 6
}

400
{
    "message": "You can only create a tournament with 4, 8, or 16 players."
}





DELETE /api/tournament/:tournament_id

response:

200
{
    "message": "Tournament deleted successfully"
}
404
{
    "message": "Tournament not found"
}

400
{
    "message": "Invalid id"
}



