POST /api/tournament/:tournament_id/join?code=1234

{
    "nickname": "7h3"
}

200
{
    "message": "joined"
}

400
{
    "error": "wrong code"
}

404
{
    "error": "tournament not found"
}


POST /api/tournament/12/leave

200
{
    "message": "left"
}

400
{
    "error": "not joined"
}


