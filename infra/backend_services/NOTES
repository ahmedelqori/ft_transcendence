#     patch       /update-profile/
#     post        /avatar/
#     get     /search/
#     get     /:id
#     get     /users/


# Notifications:
#     /api/notif/ post
#     /api/notif/ get
#     /api/notif/ delete
#     /api/notif/:id delete
#     /api/notif/ws websocket


# Friendship:
#     /api/friends/:user_id/request post
#     /api/friends/:user_id/request/accept post
#     /api/friends/:user_id/request/reject post
#     /api/friends/:user_id/friend delete
#     /api/friends/:user_id/request delete
#     /api/friends/:user_id/block post
#     /api/friends/:user_id/block delete
#     /api/friends/:user_id get
#     /api/friends/ get
#     /api/friends/search get


# 2FA:
#     /api/2fa/enable post
#     /api/2fa/verify post
#     /api/2fa/is-enable get
#     /api/2fa/disable delete




