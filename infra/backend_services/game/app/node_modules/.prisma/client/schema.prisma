generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Status {
  PENDING
  ACCEPTED
  IN_PROGRESS
  FINISHED
  CANCELED
}

model Game {
  id             Int       @id @default(autoincrement())
  playerOneId    Int
  playerTwoId    Int       @default(0)
  playerOneScore Int       @default(0)
  playerTwoScore Int       @default(0)
  winnerId       Int       @default(-1)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  status         Status    @default(PENDING)
  tournementId   Int       @default(0)
}
