{
  "tailwindCSS.includeLanguages": {
    "typescript": "html",
    "javascript": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    // Matches: class: ["text-white", "bg-black"]
    ["class:\\s*\\[([^\\]]*)\\]", "[\"'`]([^\"'`]*)[\"'`]"]
  ],
  "tailwindCSS.mode": "content",
  "tailwindCSS.validate": true
}
