// services/EventBus.js
class EventBus {
	constructor() {
	  this.events = {};
	}
  
	on(event, callback) {
	  if (!this.events[event]) {
		this.events[event] = [];
	  }
	  this.events[event].push(callback);
	  
	  // Return an unsubscribe function
	  return () => {
		this.events[event] = this.events[event].filter(cb => cb !== callback);
	  };
	}
  
	emit(event, data) {
	  if (this.events[event]) {
		this.events[event].forEach(callback => callback(data));
	  }
	}
  }
  
  export const eventBus = new EventBus();

  import Header from "./components/Header/Header.js";
import SideBar from "./components/SideBar/SideBar.js";
import { router } from "./router/Router.js";
import { eventBus } from "./services/EventBus.js";
import {
  createApp,
  createElement,
  defineComponent,
  IComponent,
  RouterOutlet,
} from "./uccello/Uccello.js";

const ROOT = document.getElementById("root");

interface AppState {
  currentPath: string;
  canShowSideBar: boolean;
  isLoggedIn: boolean;
}

const App = defineComponent<AppState>({
  async onMounted(this: IComponent<AppState>) {
    // Check initial login state
    this.state.isLoggedIn = this.checkIfUserIsLoggedIn();
    
    // Listen for auth events
    eventBus.on("auth:login", () => {
      this.state.isLoggedIn = true;
    });
    
    eventBus.on("auth:logout", () => {
      this.state.isLoggedIn = false;
    });
    
    // Listen for route changes
    router.onRouteChange((route) => {
      this.state.currentPath = route.path;
    });
  },
  
  state() {
    return {
      currentPath: router.getMatchedRoute?.path,
      canShowSideBar: true,
      isLoggedIn: false,
    };
  },
  
  methods: {
    checkIfUserIsLoggedIn() {
      // Implement your authentication check here
      return localStorage.getItem('user') !== null;
    }
  },
  
  render(this: IComponent<AppState>) {
    return createElement(
      "div",
      {
        class: [
          "h-screen",
          "m-auto",
          "w-[95%]",
          "justify-start",
          "gap-4",
          "max-lg:gap-6",
        ],
      },
      [
        createElement(Header),
        createElement(
          "main",
          {
            class: [
              "flex",
              "w-full",
              "flex-1",
              "gap-16",
              "flex-col", 
              "h-screen",
              "lg:flex-row",
              "max-lg:gap-4",
              "max-lg:flex-col",
              "max-lg:flex-col-reverse",
            ],
          },
          [
            // Only show sidebar if user is logged in
            ...(this.state.isLoggedIn ? [createElement(SideBar)] : []),
            createElement(RouterOutlet)
          ]
        ),
      ]
    );
  },
});

createApp(App, {}, { router }).mount(ROOT as HTMLElement);

